class ExecutionPipelineTests(unittest.TestCase):
    def _fixture_paths(self, root: Path) -> tuple[Path, Path, Path, Path]:
        candidate = yaml.safe_load(
            (REPO_ROOT / "examples/sample_run/03_protocol_candidate.yaml").read_text(
                encoding="utf-8"
            )
        )
        candidate["intent"]["status"] = "confirmed"
        candidate["intent"]["confirmation_refs"] = ["approval-test-001"]

        candidates = root / "candidates.yaml"
        promotions = root / "promotions.yaml"
        bindings = root / "bindings.yaml"
        inputs = root / "inputs.yaml"
        candidates.write_text(
            yaml.safe_dump([candidate], sort_keys=False), encoding="utf-8"
        )
        promotions.write_text(
            yaml.safe_dump([_promotion(candidate["id"])], sort_keys=False),
            encoding="utf-8",
        )
        bindings.write_text(
            yaml.safe_dump(
                {
                    "schema_version": "0.1.0",
                    "manifest_version": "test-bindings-0.1.0",
                    "bindings": {
                        "assess_request_completeness": {
                            "adapter": "rule.support_request_completeness.v1"
                        },
                        "generate_support_draft": {
                            "adapter": "llm.support_draft.v1"
                        },
                        "request_human_review": {
                            "adapter": "human.review_queue.v1"
                        },
                    },
                },
                sort_keys=False,
            ),
            encoding="utf-8",
        )
        inputs.write_text(
            yaml.safe_dump(
                [
                    {
                        "protocol_candidate_ref": candidate["id"],
                        "values": {"support_request": {"id": "synthetic"}},
                    }
                ],
                sort_keys=False,
            ),
            encoding="utf-8",
        )
        return candidates, promotions, bindings, inputs

    def test_current_schemas_reach_ready_without_side_effects(self) -> None:
        with tempfile.TemporaryDirectory() as temp_dir:
            paths = self._fixture_paths(Path(temp_dir))
            result = run_shadow_execution(
                paths[0], paths[1], paths[2], inputs_path=paths[3]
            )

        self.assertEqual(result.plans[0]["gate"]["route"], "READY")
        self.assertFalse(result.plans[0]["external_effects_permitted"])
        self.assertEqual(result.receipts[0]["status"], "shadowed")
        self.assertEqual(result.receipts[0]["external_effects"], [])

    def test_duplicate_promotions_are_rejected(self) -> None:
        with tempfile.TemporaryDirectory() as temp_dir:
            root = Path(temp_dir)
            candidates, promotions, bindings, inputs = self._fixture_paths(root)
            promotion = yaml.safe_load(promotions.read_text(encoding="utf-8"))[0]
            promotions.write_text(
                yaml.safe_dump([promotion, promotion], sort_keys=False),
                encoding="utf-8",
            )
            with self.assertRaises(ExecutionInputError):
                run_shadow_execution(
                    candidates,
                    promotions,
                    bindings,
                    inputs_path=inputs,
                )


if __name__ == "__main__":
    unittest.main()
