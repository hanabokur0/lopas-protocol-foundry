$schema: https://json-schema.org/draft/2020-12/schema
$id: urn:lopas:protocol-foundry:adapter-manifest:0.1.0
title: LoPAS Adapter Binding Manifest
type: object
additionalProperties: false
required:
  - schema_version
  - bindings
properties:
  schema_version:
    const: 0.1.0
  manifest_version:
    type: string
    minLength: 1
    default: 0.1.0
  bindings:
    type: object
    minProperties: 1
    additionalProperties:
      type: object
      additionalProperties: false
      required:
        - adapter
      properties:
        adapter:
          type: string
          minLength: 1
        enabled:
          type: boolean
          default: true
        config:
          type: object
          default: {}
