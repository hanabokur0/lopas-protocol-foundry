"""Command-line interface for safe shadow execution."""

from __future__ import annotations

import argparse
from pathlib import Path
import sys

from .errors import ExecutionError
from .pipeline import run_shadow_execution, write_execution_outputs


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="python -m src.execution",
        description=(
            "Compile promoted Protocol Candidates into no-side-effect shadow "
            "plans and Action Receipts."
        ),
    )
    parser.add_argument("candidates", type=Path)
    parser.add_argument("promotions", type=Path)
    parser.add_argument("bindings", type=Path)
    parser.add_argument("--inputs", type=Path, default=None)
    parser.add_argument(
        "-o",
        "--output-dir",
        type=Path,
        default=Path("receipts/full_run"),
    )
    parser.add_argument(
        "--require-ready",
        action="store_true",
        help="Return exit code 3 when no candidate reaches READY.",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        result = run_shadow_execution(
            args.candidates,
            args.promotions,
            args.bindings,
            inputs_path=args.inputs,
        )
        paths = write_execution_outputs(result, args.output_dir)
    except (ExecutionError, ValueError) as exc:
        print(f"execution error: {exc}", file=sys.stderr)
        return 1

    ready = sum(receipt["decision"]["route"] == "READY" for receipt in result.receipts)
    blocked = sum(receipt["status"] == "blocked" for receipt in result.receipts)
    denied = sum(receipt["status"] == "denied" for receipt in result.receipts)
    print(
        f"shadow execution: ready={ready} blocked={blocked} denied={denied} "
        "external_effects=0"
    )
    print(f"plans: {paths['plans']}")
    print(f"receipts: {paths['receipts']}")
    if args.require_ready and ready == 0:
        return 3
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
